# Copy this file to .env and fill in what you use. .env is never committed.

# AI review: set ONE of these. Leave all empty to run without AI.
GROQ_API_KEY=
OPENAI_API_KEY=

# Optional overrides
# LLM_PROVIDER=groq            # groq | openai | ollama
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=                # any OpenAI-compatible endpoint
# LLM_API_KEY=                 # key for LLM_BASE_URL

# Local folders the dashboard may scan (default: your home folder).
# Separate several with ; on Windows.
# REVIEWER_ALLOWED_ROOTS=C:\Users\me\Projects;D:\work

# Where the database, clones and PDF reports go (default: ./data)
# REVIEWER_DATA_DIR=
