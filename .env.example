# Copy this file to .env and add ONE AI key. .env is never committed.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Optional
# LLM_PROVIDER=gemini          # gemini | groq | openai | ollama
# LLM_MODEL=gemini-3.8-flash
# LLM_BASE_URL=                # any OpenAI-compatible endpoint
# LLM_API_KEY=                 # key for LLM_BASE_URL

# Local folders the dashboard may review (default: your home folder).
# REVIEWER_ALLOWED_ROOTS=C:\Users\me\Projects;D:\work
